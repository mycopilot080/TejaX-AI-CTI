rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidThreatWikiArticle(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'severity', 'riskScore', 'lastUpdated', 'author', 'userId'])
        && data.keys().hasOnly([
          'id', 'title', 'category', 'severity', 'riskScore', 'lastUpdated', 'author', 'version', 
          'aliases', 'tags', 'origin', 'motivation', 'targetSectors', 'summary', 'technicalDetails', 
          'killChainStage', 'mitreTechniques', 'iocs', 'detectionQueries', 'mitigations', 
          'references', 'relatedArticleIds', 'userId'
        ])
        && data.id is string && data.id.size() <= 64
        && data.title is string && data.title.size() <= 256
        && data.category in ['actor', 'malware', 'ttp', 'cve', 'framework', 'tool']
        && data.severity in ['CRITICAL', 'HIGH', 'MEDIUM', 'INFORMATIONAL']
        && data.riskScore is int && data.riskScore >= 0 && data.riskScore <= 100
        && data.author is string && data.author.size() <= 128
        && data.userId == request.auth.uid;
    }

    function isValidHistoricalActor(data) {
      return data.keys().hasAll(['id', 'name', 'userId'])
        && data.keys().hasOnly(['id', 'name', 'aliases', 'firstObserved', 'lastObserved', 'evolutionSummary', 'pastCampaignIds', 'userId'])
        && data.id is string && data.name is string && data.userId == request.auth.uid;
    }

    function isValidHistoricalCampaign(data) {
      return data.keys().hasAll(['id', 'title', 'actorId', 'userId'])
        && data.keys().hasOnly(['id', 'title', 'actorId', 'startDate', 'endDate', 'targetIndustries', 'ttpsUsed', 'outcome', 'userId'])
        && data.id is string && data.title is string && data.actorId is string && data.userId == request.auth.uid;
    }

    function isValidHistoricalVulnerability(data) {
      return data.keys().hasAll(['cveId', 'userId'])
        && data.keys().hasOnly(['cveId', 'firstDisclosed', 'exploitEvolution', 'patchAdoptionRate', 'userId'])
        && data.cveId is string && data.userId == request.auth.uid;
    }

    match /threat_wiki/{articleId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(articleId) && isValidThreatWikiArticle(incoming());
      allow update: if isSignedIn() && isValidId(articleId) && isValidThreatWikiArticle(incoming()) && isOwner(existing().userId);
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /historical_actors/{actorId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && isValidId(actorId) && isValidHistoricalActor(incoming());
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /historical_campaigns/{campaignId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && isValidId(campaignId) && isValidHistoricalCampaign(incoming());
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /historical_vulnerabilities/{cveId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && isValidId(cveId) && isValidHistoricalVulnerability(incoming());
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Support for other application entities (seeding and sync)
    match /threat_feeds/{id} { 
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
    match /assets/{id} { 
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
    match /contacts/{id} { 
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
    match /incident_tickets/{id} { 
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
    match /detection_rules/{id} { 
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
    match /threat_hunts/{id} { 
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
    match /threat_reports/{id} { 
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
