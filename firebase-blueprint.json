{
  "entities": {
    "ThreatFeedAdvisory": {
      "title": "Threat Feed Advisory",
      "description": "Represents a CTI advisory / threat feed item ingested from feeds like CISA KEV, CERT/CC, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "source": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 512 },
        "cveId": { "type": "string", "maxLength": 64 },
        "cvssScore": { "type": "number" },
        "threatActor": { "type": "string", "maxLength": 256 },
        "malwareFamily": { "type": "string", "maxLength": 256 },
        "targetSectors": { "type": "array" },
        "summary": { "type": "string", "maxLength": 4096 },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "rawPayload": { "type": "string", "maxLength": 8192 },
        "mitreTtps": { "type": "array" },
        "cyberKillChainStage": { "type": "string", "maxLength": 64 },
        "recommendedMitigations": { "type": "array" }
      },
      "required": ["id", "source", "title", "cveId", "cvssScore", "summary", "publishedAt"]
    },
    "Asset": {
      "title": "Asset Inventory Item",
      "description": "Represents an enterprise asset in the vulnerability management matrix",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "hostname": { "type": "string", "maxLength": 128 },
        "ipAddress": { "type": "string", "maxLength": 64 },
        "os": { "type": "string", "maxLength": 128 },
        "environment": { "type": "string", "maxLength": 64 },
        "tier": { "type": "string", "maxLength": 64 },
        "businessOwner": { "type": "string", "maxLength": 128 },
        "contactEmail": { "type": "string", "maxLength": 128 },
        "contactPhone": { "type": "string", "maxLength": 64 },
        "contactRole": { "type": "string", "maxLength": 128 },
        "installedSoftware": { "type": "array" },
        "lastScanTimestamp": { "type": "string", "maxLength": 64 },
        "vulnerabilities": { "type": "array" }
      },
      "required": ["id", "hostname", "ipAddress", "environment", "tier"]
    },
    "ContactDetail": {
      "title": "Contact Detail",
      "description": "Represents escalation contacts and team personnel for security response",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "pagerDutyEscalation": { "type": "string", "maxLength": 128 },
        "shiftCoverage": { "type": "string", "maxLength": 64 },
        "assignedAssets": { "type": "array" },
        "status": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 1024 }
      },
      "required": ["id", "name", "email", "shiftCoverage"]
    },
    "IncidentTicket": {
      "title": "SOC Incident Ticket",
      "description": "Represents an enterprise notable security incident ticket with SLA tracking, analyst notes, and SOAR execution history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 512 },
        "severity": { "type": "string", "maxLength": 32, "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "riskScore": { "type": "number" },
        "status": { "type": "string", "maxLength": 32, "enum": ["NEW", "IN_PROGRESS", "MITIGATED", "FALSE_POSITIVE", "CLOSED"] },
        "slaTargetMinutes": { "type": "number" },
        "slaStartTime": { "type": "string", "maxLength": 64 },
        "assignedAnalyst": { "type": "string", "maxLength": 128 },
        "affectedHost": { "type": "string", "maxLength": 128 },
        "affectedUser": { "type": "string", "maxLength": 128 },
        "sourceIp": { "type": "string", "maxLength": 64 },
        "mitreTechnique": { "type": "string", "maxLength": 256 },
        "detectionRuleId": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 4096 },
        "rawEventsCount": { "type": "number" },
        "analystNotes": { "type": "array" },
        "aiHypothesis": { "type": "string", "maxLength": 4096 }
      },
      "required": ["id", "title", "severity", "riskScore", "status", "slaTargetMinutes", "slaStartTime", "assignedAnalyst", "affectedHost"]
    },
    "ThreatReport": {
      "title": "Threat Intelligence Report",
      "description": "Represents a synthesized CTI report (24-hour summary, automated dispatch, or on-demand deep-dive)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 512 },
        "cveId": { "type": "string", "maxLength": 64 },
        "severity": { "type": "string", "maxLength": 32 },
        "cvssScore": { "type": "number" },
        "threatActor": { "type": "string", "maxLength": 256 },
        "timeWindow": { "type": "string", "maxLength": 64 },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "mitreTtp": { "type": "string", "maxLength": 256 },
        "killChainStage": { "type": "string", "maxLength": 128 },
        "executiveSummary": { "type": "string", "maxLength": 8192 },
        "technicalSummary": { "type": "string", "maxLength": 8192 },
        "assignedAnalyst": { "type": "string", "maxLength": 128 },
        "reportType": { "type": "string", "maxLength": 64 },
        "iocs": { "type": "object" },
        "recommendations": { "type": "array" },
        "references": { "type": "array" }
      },
      "required": ["id", "title", "severity", "publishedAt", "executiveSummary"]
    },
    "ThreatHuntRequest": {
      "title": "Threat Hunt Mission Request",
      "description": "Represents a threat hunting mission ticket dispatched against a specific adversary",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 256 },
        "targetIndustry": { "type": "string", "maxLength": 128 },
        "riskScore": { "type": "number" },
        "hypothesis": { "type": "string", "maxLength": 4096 },
        "selectedTTPs": { "type": "array" },
        "dataSources": { "type": "array" },
        "timeWindow": { "type": "string", "maxLength": 64 },
        "priority": { "type": "string", "maxLength": 64 },
        "assignedHunter": { "type": "string", "maxLength": 128 },
        "scopeNotes": { "type": "string", "maxLength": 2048 },
        "iocSeeds": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "maxLength": 64 },
        "requestedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "actorName", "hypothesis", "priority", "assignedHunter", "status", "requestedAt"]
    }
  },
  "firestore": {
    "/threat_feeds/{advisoryId}": {
      "schema": { "$ref": "#/entities/ThreatFeedAdvisory" },
      "description": "Collection storing all ingested CTI threat feeds and advisories"
    },
    "/assets/{assetId}": {
      "schema": { "$ref": "#/entities/Asset" },
      "description": "Collection storing enterprise asset inventory items"
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/ContactDetail" },
      "description": "Collection storing contact details and escalation personnel"
    },
    "/incident_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/IncidentTicket" },
      "description": "Collection storing all active and historical SOC notable incident tickets"
    },
    "/threat_reports/{reportId}": {
      "schema": { "$ref": "#/entities/ThreatReport" },
      "description": "Collection storing 24-hour summary reports, on-demand syntheses, and executive briefings"
    },
    "/hunt_requests/{requestId}": {
      "schema": { "$ref": "#/entities/ThreatHuntRequest" },
      "description": "Collection storing proactive threat hunt mission tickets"
    }
  }
}
