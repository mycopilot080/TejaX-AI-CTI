{
  "entities": {
    "ThreatWikiArticle": {
      "title": "Threat Wiki Article",
      "description": "A comprehensive intelligence dossier on a threat actor, malware family, TTP, or vulnerability.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the article (e.g. WIKI-ACT-001)." },
        "title": { "type": "string", "description": "The primary name or title of the threat entity.", "maxLength": 256 },
        "category": { "type": "string", "enum": ["actor", "malware", "ttp", "cve", "framework", "tool"] },
        "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "INFORMATIONAL"] },
        "riskScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "author": { "type": "string", "description": "The person or group who authored the intelligence.", "maxLength": 128 },
        "version": { "type": "string", "description": "Dossier version string.", "maxLength": 16 },
        "aliases": { "type": "array", "items": { "type": "string" }, "description": "Common names or synonyms for the threat." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Descriptive tags for indexing and search." },
        "origin": { "type": "string", "description": "The geographic or organizational origin.", "maxLength": 256 },
        "motivation": { "type": "string", "description": "The primary drivers behind the threat activity.", "maxLength": 512 },
        "targetSectors": { "type": "array", "items": { "type": "string" }, "description": "Business sectors targeted by the threat." },
        "summary": { "type": "string", "description": "Executive summary of the threat.", "maxLength": 2048 },
        "technicalDetails": { "type": "array", "items": { "type": "string" }, "description": "Bullet points detailing technical tradecraft." },
        "killChainStage": { "type": "string", "enum": ["Reconnaissance", "Weaponization", "Delivery", "Exploitation", "Installation", "Command and Control", "Actions on Objectives"] },
        "mitreTechniques": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "tactic": { "type": "string" },
              "subTechnique": { "type": "string" }
            }
          }
        },
        "iocs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["IP", "DOMAIN", "HASH_SHA256", "URL", "FILE_PATH", "MUTEX"] },
              "value": { "type": "string" },
              "description": { "type": "string" },
              "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "EMERGING"] }
            }
          }
        },
        "detectionQueries": {
          "type": "object",
          "properties": {
            "spl": { "type": "string" },
            "sigma": { "type": "string" },
            "kql": { "type": "string" },
            "yara": { "type": "string" }
          }
        },
        "mitigations": { "type": "array", "items": { "type": "string" }, "description": "Defensive recommendations and controls." },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "source": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        },
        "relatedArticleIds": { "type": "array", "items": { "type": "string" } },
        "userId": { "type": "string", "description": "The UID of the user who created/owns this record." }
      },
      "required": ["id", "title", "category", "severity", "riskScore", "lastUpdated", "author", "userId"]
    },
    "HistoricalActor": {
      "title": "Historical Threat Actor",
      "description": "Historical record of a threat actor's evolution and past behaviors.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "firstObserved": { "type": "string", "format": "date-time" },
        "lastObserved": { "type": "string", "format": "date-time" },
        "evolutionSummary": { "type": "string" },
        "pastCampaignIds": { "type": "array", "items": { "type": "string" } },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "userId"]
    },
    "HistoricalCampaign": {
      "title": "Historical Threat Campaign",
      "description": "Record of a past cyber intelligence campaign or operation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "actorId": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "targetIndustries": { "type": "array", "items": { "type": "string" } },
        "ttpsUsed": { "type": "array", "items": { "type": "string" } },
        "outcome": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "title", "actorId", "userId"]
    },
    "HistoricalVulnerability": {
      "title": "Historical Vulnerability Data",
      "description": "Historical context for vulnerabilities, including exploit evolution over time.",
      "type": "object",
      "properties": {
        "cveId": { "type": "string" },
        "firstDisclosed": { "type": "string", "format": "date-time" },
        "exploitEvolution": { "type": "array", "items": { "type": "string" } },
        "patchAdoptionRate": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["cveId", "userId"]
    },
    "Asset": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "criticality": { "type": "string" },
        "ipAddress": { "type": "string" },
        "owner": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "userId"]
    },
    "Contact": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "userId"]
    },
    "IncidentTicket": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "assignedAnalyst": { "type": "string" },
        "affectedHost": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "title", "userId"]
    },
    "DetectionRule": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "severity": { "type": "string" },
        "technique": { "type": "string" },
        "queries": { "type": "object" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "userId"]
    }
  },
  "firestore": {
    "/threat_wiki/{articleId}": {
      "schema": "ThreatWikiArticle"
    },
    "/historical_actors/{actorId}": {
      "schema": "HistoricalActor"
    },
    "/historical_campaigns/{campaignId}": {
      "schema": "HistoricalCampaign"
    },
    "/historical_vulnerabilities/{cveId}": {
      "schema": "HistoricalVulnerability"
    },
    "/assets/{assetId}": {
      "schema": "Asset"
    },
    "/contacts/{contactId}": {
      "schema": "Contact"
    },
    "/incident_tickets/{ticketId}": {
      "schema": "IncidentTicket"
    },
    "/detection_rules/{ruleId}": {
      "schema": "DetectionRule"
    }
  }
}
